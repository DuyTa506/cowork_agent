# COPY FILE NAY THANH .env VA THAY CAC GIA TRI TRUOC KHI TRIEN KHAI NOI BO
APP_ENV=production
APP_PORT=8080
POSTGRES_DB=qk3docs
POSTGRES_USER=qk3app
POSTGRES_PASSWORD=THAY_BANG_MAT_KHAU_DB_DAI_KHO_DOAN
JWT_SECRET=THAY_BANG_CHUOI_BI_MAT_NGAU_NHIEN_IT_NHAT_64_KY_TU
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_QUAN_TRI_MANH
ADMIN_FULL_NAME=Quan tri he thong
# Id don vi trong backend/app/org/units.yaml (btl = Bo Tu lenh, goc cua so do to chuc)
ADMIN_UNIT_ID=btl
UPLOAD_MAX_MB=20

# Khoa ma hoa API key luu trong CSDL (urlsafe base64, 32 byte). De trong thi dung khoa suy ra tu JWT_SECRET.
# Tao: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_KEY=
QDRANT_API_KEY=THAY_BANG_KHOA_QDRANT

# Kho doi tuong (MinIO) luu tep goc cua van ban va tep dinh kem. Khong co gia tri mac dinh: phai dat truoc khi chay.
MINIO_ROOT_USER=THAY_BANG_TEN_NGUOI_DUNG_MINIO
MINIO_ROOT_PASSWORD=THAY_BANG_MAT_KHAU_MINIO_TOI_THIEU_12_KY_TU
S3_BUCKET=qk3-documents

# Cac dia chi mo hinh duoi day chi la GIA TRI MAC DINH; quan tri vien doi trong Quan tri > He thong.
# Chi dung may chu trong mang noi bo / may chu quan khu. Khong dung dich vu AI cong cong cho du lieu noi bo.
QK3_LLM_BASE_URL=
QK3_LLM_MODEL=
QK3_LLM_KEY=
# Khuyen nghi (do dac ngoai tuyen, xem README muc 8): embedding Harrier qua tang serving intramind
# (Quan tri > He thong > Embedding: loai 'intramind', 640 chieu) va Rerank bge-reranker-v2-m3 (giao thuc cohere/tei), 30 doan.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=
EMBEDDING_QUERY_PREFIX=
RERANK_BASE_URL=
RERANK_MODEL=
OCR_BASE_URL=
