# qk3-serving: copy to .env and edit. Every model is loaded from a local path, no Internet needed at run time.

# --- model paths (read-only mounts) ---
LLM_DIR=/opt/intramind/models/llm/Qwen3.6-35B-A3B-NVFP4-v1
EMBED_DIR=/opt/intramind/models/embedding/harrier-oss-270m-v1
# bge-reranker-v2-m3 is not under /opt/intramind/models/rerank yet; this is the local HF cache snapshot.
# Run scripts/stage_rerank.sh once to copy it into /opt/intramind/models/rerank/bge-reranker-v2-m3.
RERANK_DIR=
# OCR (Peppercorn v3): checkpoint not chosen yet, leave empty. See ocr/README.md. Never upload this checkpoint.
OCR_DIR=

# --- names clients use ---
LLM_MODEL_NAME=qwen3.6-35b-a3b
EMBED_MODEL_NAME=microsoft/harrier-oss-v1-270m
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
OCR_MODEL_NAME=peppercorn-v3

# --- network ---
# 127.0.0.1 = only this machine. Use 0.0.0.0 only inside a trusted internal network (no API key is set).
BIND_ADDR=127.0.0.1
LLM_PORT=8201
EMBED_BACKEND_PORT=8202
RERANK_BACKEND_PORT=8203
ADAPTER_PORT=8204
OCR_PORT=8205

# --- GPU memory (fraction of the whole card per service, see README table) ---
GPU=0
LLM_GPU_UTIL=0.78
EMBED_GPU_UTIL=0.04
RERANK_GPU_UTIL=0.04
OCR_GPU_UTIL=0.05

# --- LLM ---
LLM_MAX_LEN=131072
LLM_MAX_SEQS=64
# extra vllm args, e.g. "--prefix-match-unit 16" (verified on the production config only, not on this one)
LLM_EXTRA_ARGS=

# --- adapter limits ---
# native contexts: harrier-oss-v1-270m 32,768 tokens, bge-reranker-v2-m3 8,192 tokens (query + document)
EMBED_MAX_LEN=32768
RERANK_MAX_LEN=8192
EMBED_MAX_TOKENS=32768
EMBED_MAX_BATCH=64
RERANK_MAX_TOKENS=8192
RERANK_MAX_BATCH=100
EMBED_QUERY_PREFIX="Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: "

IMAGE=vllm/vllm-openai:v0.32.0
RESTART_POLICY=no
